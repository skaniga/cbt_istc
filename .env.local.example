# Template .env.local — International Science and Technology Competitions (ISTC)
# Salin file ini menjadi .env.local dan isi dengan nilai dari Supabase Dashboard Anda.
# JANGAN commit .env.local ke Git!
#
# ─── Cara mendapatkan nilai ini ─────────────────────────────────────────────
# 1. Buka https://supabase.com/dashboard → Project Settings → API
# 2. Salin "Project URL" → NEXT_PUBLIC_SUPABASE_URL
# 3. Salin "anon public" → NEXT_PUBLIC_SUPABASE_ANON_KEY
# 4. Salin "service_role secret" → SUPABASE_SERVICE_ROLE_KEY
#    (SUPABASE_SERVICE_ROLE_KEY hanya digunakan di server-side, TIDAK terekspos ke browser)
#
# ─── Wajib diisi di Vercel Environment Variables ────────────────────────────
# Dashboard Vercel → Project Settings → Environment Variables → tambahkan ke-3 key di bawah

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
